# Copy this file to .env and adjust if your SQL Server settings differ.
SECRET_KEY=change-this-to-a-long-random-secret
DB_SERVER=(LOCAL)\SQLEXPRESS
DB_NAME=LibraryDB_Complete
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
LOAN_DAYS=14
MAX_BOOKS_PER_READER=5
MAX_EXTENSIONS=2
FINE_PER_DAY=5000
